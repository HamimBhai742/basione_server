{
  "info": {
    "_postman_id": "c8f92102-12a4-4d87-991f-827361ab7291",
    "name": "Basione - Orders & Notifications APIs",
    "description": "Combined Postman Collection for Admin/User Orders and Notification Module in Basione Server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Orders & Admin Total Orders",
      "item": [
        {
          "name": "Get Order Status Summary (Counts & Stats)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/order-status-summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "order-status-summary"
              ]
            },
            "description": "Returns counts for totalOrders, pending, processing, ready, shipped, delivered, cancelled, and refunded orders."
          },
          "response": []
        },
        {
          "name": "Get Admin Total Orders (Pagination, Search & Sort)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/total-orders?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "total-orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (defaults to 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (defaults to 10)"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "description": "Sort field (createdAt, total, status, etc.)"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "Sort direction: desc (newest 1st) or asc"
                },
                {
                  "key": "searchTerm",
                  "value": "",
                  "description": "Optional search term for customer name, email, order ID, SKU, or banner name",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Optional filter by status: pending, processing, delivered, cancelled",
                  "disabled": true
                }
              ]
            },
            "description": "Fetch all orders for Admin with full pagination, search, filter, and newest-first sorting."
          },
          "response": []
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"processing\",\n  \"carrier\": \"QLS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/update-order/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "update-order",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "ORDER_ID_HERE",
                  "description": "ID of the order to update"
                }
              ]
            },
            "description": "Update order status (e.g., pending, processing, shipped, delivered, cancelled)."
          },
          "response": []
        },
        {
          "name": "Get User My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/my-order?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "my-order"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Fetch current logged-in user's orders."
          },
          "response": []
        },
        {
          "name": "Get Single Order Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "ORDER_ID_HERE"
                }
              ]
            },
            "description": "Fetch single order details by Order ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get All Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Retrieve all notifications for the authenticated user or admin."
          },
          "response": []
        },
        {
          "name": "Mark All Notifications as Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification/mark-all-read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification",
                "mark-all-read"
              ]
            },
            "description": "Mark all notifications as read."
          },
          "response": []
        },
        {
          "name": "Mark Single Notification as Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification/:id/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification",
                ":id",
                "read"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "NOTIFICATION_ID_HERE"
                }
              ]
            },
            "description": "Mark single notification as read by ID."
          },
          "response": []
        },
        {
          "name": "Delete Single Notification",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "NOTIFICATION_ID_HERE"
                }
              ]
            },
            "description": "Delete a single notification by ID."
          },
          "response": []
        },
        {
          "name": "Delete Multiple Notifications",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"NOTIFICATION_ID_1\",\n    \"NOTIFICATION_ID_2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification/delete-multiple",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification",
                "delete-multiple"
              ]
            },
            "description": "Delete multiple notifications by providing an array of IDs in request body."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "YOUR_BEARER_TOKEN_HERE",
      "type": "string"
    }
  ]
}
