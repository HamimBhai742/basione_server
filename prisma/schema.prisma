generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                         String    @id @default(auto()) @map("_id") @db.ObjectId
  name                       String
  email                      String    @unique
  password                   String
  role                       Role      @default(user)
  status                     Status    @default(active)
  isVerified                 Boolean   @default(false)
  otp                        String?
  otpExpiry                  DateTime?
  forgetPasswordToken        String?
  forgetPasswordTokenExpires DateTime?
  image                      String?
  phone                      String?
  location                   String?
  banners                    Banner[]
  orders                     Order[]
  addresses                  Address[]
  payments                   Payment[]
  templateReviews            TemplateReview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  blogs     Blog[]
  chatbotConversations ChatbotConversation[] @relation("UserChatbotConversations")
}

enum Status {
  active
  inactive
  blocked
}

enum Role {
  user
  admin
}

model Banner {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String?
  templateCategoryId String? @db.ObjectId

  occasion String
  style    String
  headline String
  slug     String?
  name     String?
  price    Float
  priceInclVat Float?
  priceExclVat Float?
  vatAmount Float?
  vatRate Float?
  areaM2 Float?
  pricePerM2 Float?
  isVatIncluded Boolean?

  hobbies String[] // PostgreSQL array

  description String?

  sizeType  String
  sizeLabel String?
  width     Int
  height    Int

  imageUrl String
  variant  Int

  designNumber String?

  revisedPrompt String?

  canvasJSON String?
  source String?
  savedFromEditor Boolean @default(false)
  isSavedDesign Boolean @default(false)
  isOrdered Boolean @default(false)
  designStatus String @default("saved")
  lifecycleStatus String @default("saved")
  orderedAt DateTime?
  orderId String? @db.ObjectId

  metaTitle       String?
  metaDescription String?
  h1Title         String?
  introText       String?
  seoDescription  String?

  isSelected Boolean      @default(false)
  isTemplate Boolean      @default(false)
  isReadymade Boolean     @default(false)
  mockupUrl   String?
  status     BannerStatus @default(GENERATED)

  generationId String? // group 4 variants

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  templateCategory TemplateCategory? @relation("OldCategoryRelation", fields: [templateCategoryId], references: [id])
  templateCategoryIds String[] @db.ObjectId
  templateCategories TemplateCategory[] @relation("CategoryRelation", fields: [templateCategoryIds], references: [id])
  orders    Order[]
  sourceTemplateId String? @db.ObjectId
  sourceTemplate   Banner? @relation("TemplateCopies", fields: [sourceTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateCopies    Banner[] @relation("TemplateCopies")
  templateReviews   TemplateReview[] @relation("TemplateReviews")

  svgMaskId   String?  @db.ObjectId
  svgMask     SvgMask? @relation("BannerToSvgMask", fields: [svgMaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([generationId])
  @@index([designNumber])
  @@index([templateCategoryId])
  @@index([sourceTemplateId])
  @@index([svgMaskId])
  @@index([createdAt])
}

model SvgMask {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  svgUrl    String   // URL of the SVG on S3
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  banners   Banner[] @relation("BannerToSvgMask")
}


model TemplateCategory {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  oldTemplates Banner[] @relation("OldCategoryRelation")
  templateIds String[] @db.ObjectId
  templates Banner[] @relation("CategoryRelation", fields: [templateIds], references: [id])
}

enum BannerStatus {
  SELECTED
  GENERATED
  ORDERED
}

enum Category {
  wedding
  birthday
  kids_party
  baby_shower
  engagement
}

model Counter {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique
  seq Int
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  quantity Int

  deliveryType   DeliveryType
  deliveryMethod DeliveryMethod
  deliveryLabel  String?
  deliveryTime   String
  deliveryFee    Float          @default(0)

  hasEyelets Boolean @default(false)
  eyeletsFee Float   @default(0)

  subtotal          Float @default(0)
  priceExcludingVat Float @default(0)
  vatRate           Float @default(0.21)
  vatAmount         Float @default(0)
  total             Float

  trackingNumber String? @unique

  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(pending)

  bannerId String
  banner   Banner? @relation(fields: [bannerId], references: [id])

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  isGuest             Boolean   @default(false)
  guestEmail          String?
  guestName           String?
  guestPhone          String?
  guestOrderToken     String?   @unique
  guestTokenExpiresAt DateTime?

  payment   Payment?
  addresses Address?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice?
  shipments QlsShipment[]
  templateReview TemplateReview?
}

model TemplateReview {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  rating  Int
  comment String?

  templateId String @db.ObjectId
  template   Banner @relation("TemplateReviews", fields: [templateId], references: [id])

  orderId String @unique @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([userId])
}

enum QlsShipmentStatus {
  draft
  created
  printed
  pre_transit
  in_transit
  delivered
  returned
  returned_to_sender
  failed
}

enum QlsShipmentEventType {
  created
  status
  label
  refresh
  webhook
  failed
}

model QlsShipment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  qlsShipmentId        String? @unique
  companyId            String
  brandId              String
  productId            Int?
  productCombinationId Int
  reference            String
  status               QlsShipmentStatus @default(draft)
  weight               Int?
  barcode              String?
  trackingId           String?
  trackingUrl          String?
  labelPdfUrl          String?
  labelZplUrl          String?
  servicepointCode     String?
  lastError            String?
  rawRequest           Json?
  rawResponse          Json?
  lastSyncedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    QlsShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([barcode])
  @@index([trackingId])
  @@index([reference])
}

model QlsShipmentEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shipmentId String?      @db.ObjectId
  shipment   QlsShipment? @relation(fields: [shipmentId], references: [id])

  orderId       String?              @db.ObjectId
  eventType     QlsShipmentEventType
  qlsStatus     String?
  qlsShipmentId String?
  barcode       String?
  trackingId    String?
  payload       Json
  receivedAt    DateTime             @default(now())

  @@index([shipmentId])
  @@index([orderId])
  @@index([qlsShipmentId])
  @@index([barcode])
  @@index([trackingId])
}

model Invoice {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId   String @unique @db.ObjectId
  userId    String? @db.ObjectId
  paymentId String @db.ObjectId

  invoiceNumber   String  @unique
  invoiceUrl      String
  invoiceFilePath String?

  amount    Float
  vatAmount Float     @default(0)
  status    String    @default("generated")
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
}

enum InvoiceStatus {
  generated
  sent
  failed
}

enum DeliveryType {
  standard_delivery
  express_delivery
  express_pickup
  standard_pickup
}

enum DeliveryMethod {
  delivery
  pickup
}

enum PaymentStatus {
  pending
  paid
  cancelled
  failed
  expired
}

enum OrderStatus {
  pending
  processing
  ready
  shipped
  delivered
  cancelled
  refunded
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  amount        Float
  transactionId String        @unique
  status        PaymentStatus
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  paymentJSON   Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

model Address {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String
  email       String
  houseNumber String
  companyName String?
  street      String
  city        String
  zipCode     String
  address     String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  orderId     String  @unique
  order       Order   @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decoration {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  image      String
  categoryId String
  category   DecorationCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DecorationCategory {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  decorations Decoration[]
}

model Font {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  family    String
  sourceUrl String
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Faq {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  category String
  question String
  answer   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Blog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  slug       String   @unique
  content    String
  coverImage String?
  images     String[]
  category   String
  tags       String[]
  isFeatured Boolean  @default(false)

  metaTitle       String?
  metaDescription String?

  status BlogStatus @default(DRAFT)

  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id])

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChatbotRole {
  user
  assistant
  developer
}

model ChatbotConversation {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String          @unique
  userId         String?         @db.ObjectId
  title          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user     User?            @relation("UserChatbotConversations", fields: [userId], references: [id])
  messages ChatbotMessage[]

  @@index([userId])
}

model ChatbotMessage {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  conversationObjectId String             @db.ObjectId
  role                 ChatbotRole
  content              String
  model                String?
  isPartial            Boolean            @default(false)
  createdAt            DateTime           @default(now())

  conversation ChatbotConversation @relation(fields: [conversationObjectId], references: [id])

  @@index([conversationObjectId])
}

model ChatbotSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackgroundImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
